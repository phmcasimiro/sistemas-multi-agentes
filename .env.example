# Cria o template de variáveis de ambiente sem expor suas chaves
cat << 'EOF' > .env
# OpenCode Zen (padrão)
PROVEDOR=zen
OPENAI_API_KEY=sk-sua_chave_aqui
OPENAI_BASE_URL=https://opencode.ai/zen/v1
OPENAI_MODEL=deepseek-v4-flash

# Fallback local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# MQTT (Aula 4)
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_PREFIXO=pcdf/demo

# Aula 5 — bancos (PostgreSQL/SQL Server) e MCP Servers
PG_HOST=127.0.0.1
PG_PORT=5434
PG_USER=postgres
PG_PASSWORD=Postgres@12345
PG_DATABASE=cisp_ocorrencias

MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong@Password123
MSSQL_DATABASE=cisp_operacoes

MCP_OCORRENCIAS_URL=http://localhost:8001/mcp
MCP_OPERACOES_URL=http://localhost:8002/mcp
MCP_SERVICOS_URL=http://localhost:8003/mcp

EVENTOS_CSV_URL=
EOF

# Registra as bibliotecas instaladas no venv
pip freeze > requirements.txt
