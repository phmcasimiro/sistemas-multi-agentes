# ==============================================================================
# Configuração de Ambiente — Sistemas Multiagentes com IA
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
#
# Provedores suportados (Aulas 1 a 5):
#   - zen     (OpenCode Zen — padrão do laboratório)
#   - openai  (OpenAI oficial)
#   - ollama  (Ollama local)
#
# Provedores suportados (Aulas 6 e 7 — LangGraph/Grafos):
#   - mock    (100% determinístico, offline, sem chaves e sem custo)
#   - openai  (OpenAI oficial)
#   - ollama  (Ollama local)
#   - claude  (Anthropic Claude)
# ============================================================================== 

# ------------------------------------------------------------------------------
# Provedor Ativo (zen / openai / ollama / mock / claude)
# ------------------------------------------------------------------------------
PROVEDOR=zen

# ------------------------------------------------------------------------------
# OpenCode Zen / OpenAI
# ------------------------------------------------------------------------------
OPENAI_API_KEY=REPLACE_WITH_REAL_OPENAI_KEY
OPENAI_BASE_URL=https://opencode.ai/zen/v1
OPENAI_MODEL=deepseek-v4-flash
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Ollama Local (gratuito e offline)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# Anthropic Claude (Aulas 6 e 7 — opcional)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ------------------------------------------------------------------------------
# JEV AI (Aula 6 — Desafio 3 — opcional, cai em mock se vazio)
# ------------------------------------------------------------------------------
JEV_AI_API_KEY=

# ------------------------------------------------------------------------------
# LangSmith / Tracing (Opcional)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# ------------------------------------------------------------------------------
# MQTT (Aula 4 — Comunicação Assíncrona Agente-a-Agente)
# ------------------------------------------------------------------------------
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_PREFIXO=pcdf/demo

# ------------------------------------------------------------------------------
# Aula 5 — Bancos de Dados (PostgreSQL / SQL Server) e Servidores MCP
# ------------------------------------------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5434
PG_USER=postgres
PG_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
PG_DATABASE=cisp_ocorrencias

MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=REPLACE_WITH_STRONG_MSSQL_PASSWORD
MSSQL_DATABASE=cisp_operacoes

MCP_OCORRENCIAS_URL=http://localhost:8001/mcp
MCP_OPERACOES_URL=http://localhost:8002/mcp
MCP_SERVICOS_URL=http://localhost:8003/mcp

EVENTOS_CSV_URL=
